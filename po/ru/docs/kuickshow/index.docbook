> <guimenuitem
>Удалить в корзину</guimenuitem
> </menuchoice
></term>
<listitem
><para
><action
>Переместить</action
> текущий файл в корзину. Программа запросит подтверждение.</para
></listitem>
</varlistentry>

<varlistentry>
<term
><menuchoice
><shortcut
><keycombo action="simul"
> &Alt;<keycap
>Return</keycap
></keycombo
></shortcut
